# Copy to .env (git-ignored) for local work. On Vercel these are set by the
# Supabase integration (Project → Settings → Environment Variables).
# The v0.1 prototype does not read them yet; data still lives in the browser.
#
# Public (safe in the browser ONLY with row-level security on every table):
SUPABASE_URL=
SUPABASE_ANON_KEY=
#
# Server-only. Never expose to the browser, never commit:
SUPABASE_SERVICE_ROLE_KEY=
