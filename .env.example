# Names of the Supabase variables the build reads (values never in git).
# On Vercel they are set by the Supabase integration (Project → Settings → Environment Variables).
# When SUPABASE_URL and a publishable key are both set at build time, prototype/dist/index.html
# runs in cloud mode (real accounts, cloud-saved workspaces). Without them: demo mode.
# The build does not read this file; export the variables in your shell to try cloud mode locally.
#
# Public (safe in the browser ONLY because every table has row-level security):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# (fallbacks the build also accepts: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
#  SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY)
#
# Server-only. Never expose to the browser, never commit. The build fails if one would be inlined.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
